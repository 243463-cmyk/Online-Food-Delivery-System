<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Orders - FoodExpress</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header class="navbar">
        <div class="logo">Food<span>Express</span></div>
        <nav>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/cart">Cart</a></li>
                <li><a href="/orders" class="active">Orders</a></li>
            </ul>
        </nav>
    </header>

    <main class="container" style="margin-top: 35px;">
        <h3 style="font-size: 24px; margin-bottom: 25px; color: #2f3542;">Order Tracking Logs</h3>
        
        <div style="display: flex; flex-direction: column; gap: 15px;">
            <% orders.forEach(order => { %>
                <div style="background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <h4 style="color: #2f3542; font-size: 18px; margin-bottom: 5px;"><%= order.id %></h4>
                        <p style="font-size: 14px; color: #747d8c;">Dispatched Date: <%= order.date %></p>
                    </div>
                    <div style="text-align: right;">
                        <p style="font-weight: 700; color: #ff4757; font-size: 18px; margin-bottom: 5px;">Rs. <%= order.total %></p>
                        <span style="background: #e3fcef; color: #26af5f; padding: 4px 12px; border-radius: 15px; font-size: 12px; font-weight: 600;"><%= order.status %></span>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>
</body>
</html>